# BlobFi — Environment Variables
# Copy to .env and fill in your keys

# App
APP_ENV=development
APP_PORT=8000

# Sui / Tatum (get free key at dashboard.tatum.io)
TATUM_API_KEY=
SUI_NETWORK=mainnet

# Walrus (testnet publisher — switch to mainnet for submission)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Pipeline
SNAPSHOT_INTERVAL_SECONDS=300
TOP_PROTOCOLS_COUNT=10
